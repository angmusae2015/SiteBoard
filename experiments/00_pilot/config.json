{
  "experiment": "00_pilot",
  "model_name": "Qwen/Qwen2.5-1.5B-Instruct",
  "train_file": "dataset/splits/00_pilot/train.jsonl",
  "test_file": "dataset/splits/00_pilot/test.jsonl",
  "split_meta": "experiments/00_pilot/split_meta.json",
  "work_types": "dataset/work_type.json",
  "dataset_file": "dataset/raw/dataset_org.json",
  "clusters_file": null,
  "output_dir": "artifacts/checkpoints/00_pilot",
  "adapter_path": "artifacts/checkpoints/00_pilot/final_adapter",
