{
  "experiment": "02_concatenation",
  "model_name": "Qwen/Qwen2.5-1.5B-Instruct",
  "train_file": "dataset/splits/02_concatenation/train.jsonl",
  "test_file": "dataset/splits/02_concatenation/test.jsonl",
  "split_meta": "experiments/02_concatenation/split_meta.json",
  "work_types": "dataset/work_type.json",
  "dataset_file": "dataset/raw/dataset_org.json",
  "clusters_file": null,
  "output_dir": "artifacts/checkpoints/02_concatenation",
  "adapter_path": "artifacts/checkpoints/02_concatenation/final_adapter",
  "report_file": "artifacts/reports/02_concatenation/evaluation.json",
  "device": "cuda",
  "training": {
    "epochs": 3,
    "batch_size": 2,
    "grad_accum": 4,
